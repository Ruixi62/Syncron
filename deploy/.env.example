# Copier en .env puis remplir. Ne jamais publier le fichier .env.

# Nom de domaine pointant vers le serveur (enregistrement DNS A/AAAA), sans https://
SYNCRON_DOMAIN=api.syncron.exemple.fr

# Mot de passe PostgreSQL (long et aléatoire) : openssl rand -base64 32
POSTGRES_PASSWORD=

# Secret de signature des jetons (64 caractères aléatoires) : openssl rand -hex 32
SYNCRON_JWT_SECRET=

# Application Discord (https://discord.com/developers/applications → OAuth2)
# Redirect à déclarer : https://<SYNCRON_DOMAIN>/api/v1/auth/discord/callback
SYNCRON_DISCORD_CLIENT_ID=
SYNCRON_DISCORD_CLIENT_SECRET=

# Facultatif : n'autoriser que les membres de ce serveur Discord (ID du serveur)
SYNCRON_DISCORD_REQUIRED_GUILD_ID=

# IDs Discord des administrateurs (séparés par des virgules) — toujours admins
SYNCRON_ADMIN_DISCORD_IDS=

# Version minimale du client acceptée (forcer la mise à jour des joueurs)
SYNCRON_MIN_CLIENT_VERSION=4.0.0
SYNCRON_WORKERS=2
