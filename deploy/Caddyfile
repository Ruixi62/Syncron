# Reverse proxy HTTPS. Le certificat est obtenu et renouvelé automatiquement.
{$SYNCRON_DOMAIN} {
	encode zstd gzip

	@media path /media/*
	header @media Cache-Control "public, max-age=31536000, immutable"
	# Les fichiers média ne sont que des images : aucun script, aucune page, même si un fichier était piégé.
	header @media Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; sandbox"

	request_body {
		max_size 10MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy api:8000
}
